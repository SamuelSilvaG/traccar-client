<?xml version="1.0" encoding="utf-8"?>
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">
    <restriction
        android:key="id"
        android:title="@string/restriction_id_title"
        android:restrictionType="string"
        android:description="@string/restriction_id_desc" />
    <restriction
        android:key="url"
        android:title="@string/restriction_url_title"
        android:restrictionType="string"
        android:description="@string/restriction_url_desc"
        android:defaultValue="http://mdm.grupo-nso.com.br:5055" />
    <restriction
        android:key="status"
        android:title="@string/restriction_status_title"
        android:restrictionType="bool"
        android:description="@string/restriction_status_desc"
        android:defaultValue="true" />
    <restriction
        android:key="interval"
        android:title="@string/restriction_interval_title"
        android:restrictionType="integer"
        android:description="@string/restriction_interval_desc"
        android:defaultValue="300" />
    <restriction
        android:key="distance"
        android:title="@string/restriction_distance_title"
        android:restrictionType="integer"
        android:description="@string/restriction_distance_desc"
        android:defaultValue="75" />
    <restriction
        android:key="angle"
        android:title="@string/restriction_angle_title"
        android:restrictionType="integer"
        android:description="@string/restriction_angle_desc"
        android:defaultValue="0" />
    <restriction
        android:key="accuracy"
        android:title="@string/restriction_accuracy_title"
        android:restrictionType="string"
        android:description="@string/restriction_accuracy_desc"
        android:defaultValue="medium" />
</restrictions>
